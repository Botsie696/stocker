# --- Public.com API ---
# Create this in Public.com > Settings > Developer/API. This is the long-lived
# "personal secret" — it is NOT sent directly on trading calls. The backend
# exchanges it for a short-lived access token (see public_client.py).
PUBLIC_API_SECRET=your_public_secret_here

# Optional. If unset, the app calls GET /accounts and auto-picks a tradable
# BROKERAGE account (skipping e.g. a HIGH_YIELD cash account with
# RESTRICTED_NO_TRADING). If you have more than one brokerage account, set
# this explicitly to the opaque accountId GET /accounts returns for the one
# you want (not your name) — check the terminal DEBUG_API dump to see it.
PUBLIC_ACCOUNT_ID=

# --- Anthropic (Claude) API ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# claude-3-5-haiku-latest is deprecated. claude-haiku-4-5 is the current
# cheap/fast tier; claude-sonnet-5 is stronger reasoning for a similar task
# like judging portfolio efficiency. Default here is Sonnet 5 for quality —
# switch to claude-haiku-4-5 if you want it cheaper/faster.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Safety guardrails (hardcoded checks live in guardrails.py; these just
#     tune the thresholds) ---
# ETF_WHITELIST is the ticker universe for Mode 1 (Internal Rebalance) and
# Mode 3 (Fresh Cash Buy). Modes 2 and 4 additionally allow tickers from
# data_scraper.py's Python-vetted external candidate list (real ticker,
# expense ratio <=0.50%, holdings overlap <=60% — both hardcoded in
# data_scraper.py, not env-configurable, matching the existing philosophy
# of not letting easily-fat-fingered config loosen safety-critical caps).
ETF_WHITELIST=VOO,QQQM,AVUV,CALF,AVLV,RZV,RWJ
# Default per-trade ceiling. The UI's Budget field, when filled in, replaces
# this for that one analyze/execute run (and also caps the total of all BUY
# trades in the batch) — it's still a Python-enforced number captured at
# proposal time, never something Claude's own output can raise.
MAX_TRADE_USD=500

# When true (default), the app runs the full pipeline (auth, fetch, Claude,
# preflight) but does NOT call POST /order — it logs what it WOULD submit.
# Flip to false only once you've verified a dry run looks correct.
DRY_RUN=true

# --- Local server ---
FLASK_PORT=5001
# Random value used to sign the local Flask session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change_me_to_a_random_value

# Optional. If set, every page/route requires this password (session login
# at /login, or a one-time `?key=<password>` query param that also starts a
# session — useful for a bookmarked mobile URL over Tailscale). If unset,
# the app has no auth at all — fine for pure localhost use, NOT fine once
# app.run() binds to 0.0.0.0 for LAN/Tailscale access.
APP_PASSWORD=

# --- GitHub Actions cloud automation (github_service.py) ---
# Personal Access Token needing BOTH of these, confirmed by hitting real
# 403s while building this against Botsie696/stocker:
#   - Actions: read and write   (dispatch/schedule/list workflow runs)
#   - Contents: read and write  (commit/read/delete queue/scheduled_task.json
#     for the cloud-native "schedule task, then shut the Mac down" flow)
# Classic PAT: check the full "repo" scope. Fine-grained PAT: select this
# repo specifically and grant both permissions above explicitly — fine-
# grained tokens do NOT get repo access or extra permissions implicitly.
# Create/edit at https://github.com/settings/tokens
#
# Named GH_PAT, not GITHUB_PAT — GitHub reserves the GITHUB_ prefix for its
# own secrets, so a *repository secret* literally named GITHUB_PAT is
# rejected outright ("Secret names must not start with GITHUB_"). This is
# only the local .env name; inside the Actions run itself, the workflow
# uses GitHub's own auto-provided secrets.GITHUB_TOKEN instead.
GH_PAT=your_github_pat_here
GITHUB_OWNER=Botsie696
GITHUB_REPO=stocker
GITHUB_WORKFLOW_FILE=rebalance.yml
GITHUB_REF=main

# These same secrets also need to be added separately as GitHub Repository
# Secrets (Settings > Secrets and variables > Actions) on Botsie696/stocker
# for the workflow itself to use — PUBLIC_API_SECRET, PUBLIC_ACCOUNT_ID
# (optional), ANTHROPIC_API_KEY, FLASK_SECRET_KEY. As of this writing that
# repo is PUBLIC — strongly recommend making it private (Settings > Danger
# Zone > Change visibility) before scheduling anything real: the cloud
# queue file commits your actual planned trades (tickers, dollar amounts,
# timing) to the repo before they execute, which a public repo exposes to
# anyone. Also consider a GitHub Environment with required reviewers on
# the "execute" job for an extra manual-approval gate before real orders
# can fire from an automated/scheduled run.